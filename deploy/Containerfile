# Nidaro production image.
#
# Two stages: locked dependencies and the project wheel are resolved with uv
# in the builder; the runtime copies only the virtual environment. The uv
# base image is built on the matching python base, so the venv interpreter
# path (/usr/local/bin/python3.14) is valid in the runtime stage.

FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim AS build
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app

# Dependency layer: cached unless the lockfile changes.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --no-editable

# Project layer: hatchling builds the wheel from src/ (pyproject references
# README.md, so it travels with the source).
COPY README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.14-slim-bookworm AS runtime
RUN useradd --create-home --uid 1000 nidaro
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
# Not part of the wheel; `alembic upgrade head` needs both next to the
# working directory (alembic.ini sets script_location = migrations).
COPY migrations ./migrations
COPY alembic.ini ./
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1
USER nidaro
CMD ["uvicorn", "nidaro.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
