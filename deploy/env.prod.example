# Nidaro prod environment — TEMPLATE.
#
# Copy to ~/.config/nidaro/prod.env and set the values:
#   install -m 600 deploy/env.prod.example ~/.config/nidaro/prod.env
# (deploy/install.sh does this for you on first run.)
#
# This file is read by podman on the host at container start. Podman env
# files do NOT interpolate variables: the database password is embedded
# literally in POSTGRES_PASSWORD and inside NIDARO_DATABASE_URL, and the
# two values must match. Generate one with:
#   openssl rand -base64 24
#
# Never commit the filled-in file. It lives outside the repository.

# PostgreSQL — used only when the data volume is initialized the first time.
POSTGRES_PASSWORD=change-me

# Nidaro configuration. The host is "localhost" for both services because
# every container of the pod shares one network namespace.
NIDARO_DATABASE_URL=postgresql+psycopg://nidaro:change-me@localhost:5432/nidaro
NIDARO_REDIS_URL=redis://localhost:6379/0
NIDARO_ENV=production
NIDARO_TIMEZONE=Europe/Prague

# Assistant. pydantic-ai picks the provider from the model string.
NIDARO_MODEL=
# Provider key — uncomment the one that matches NIDARO_MODEL:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Optional observability.
NIDARO_LOGFIRE_TOKEN=

# Optional. CDP port of the pod's persistent Chromium (the WhatsApp web
# bridge browser; see docs/deployment.md). The default matches the Quadlet
# unit. There is no host setting: inside the pod everything is localhost.
# NIDARO_CHROMIUM_CDP_PORT=9222
